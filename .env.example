# Firebase Web SDK config for this app — see README.md "Set up Firebase"
# for exactly where to find each of these in the Firebase console.
#
# Copy this file to .env.local (already gitignored) for local development.
# For a GitHub Pages deploy, set the same names as repository secrets
# instead (Settings -> Secrets and variables -> Actions); deploy.yml reads
# them from there at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to point the app at local Auth + Firestore emulators instead of a
# real project (`firebase emulators:start --only auth,firestore`). Leave
# unset for real use — never set this in a deployed build.
VITE_USE_EMULATOR=
